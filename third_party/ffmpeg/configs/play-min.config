# legato play-min: mobile playback. LGPL only, decoders, no encoders.
--disable-gpl
--disable-nonfree
--disable-programs
--disable-doc
--disable-debug
--disable-avdevice
--disable-avfilter
--disable-network
--enable-static
--disable-shared
--disable-everything
--enable-protocol=file,crypto
--enable-demuxer=mov,matroska,flv,mpegts,aac,mp3,ogg
--enable-decoder=h264,hevc,aac,mp3,opus,flac
--enable-parser=h264,hevc,aac,opus,mpeg4video
--enable-libdav1d
--enable-decoder=libdav1d
--extra-cflags=-fvisibility=hidden
--disable-stripping
