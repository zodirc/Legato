# legato play-full: desktop playback. Adds containers, codecs, and libass.
--disable-gpl
--disable-nonfree
--disable-programs
--disable-doc
--disable-debug
--disable-avdevice
--enable-static
--disable-shared
--disable-encoders
--disable-muxers
--enable-libass
--enable-libdav1d
--extra-cflags=-fvisibility=hidden
--disable-stripping
