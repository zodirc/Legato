# Local demo: LGPL decoders, no external libraries, no assembler requirement.
--disable-gpl
--disable-nonfree
--disable-programs
--disable-doc
--disable-debug
--disable-autodetect
--disable-avdevice
--disable-avfilter
--disable-network
--disable-x86asm
--enable-static
--disable-shared
--disable-everything
--enable-swresample
--enable-protocol=file
--enable-demuxer=mov,matroska,flv,mpegts,aac,mp3,ogg,wav
--enable-decoder=h264,aac,mp3,flac,pcm_s16le,pcm_s16be
--enable-parser=h264,aac,mpeg4video
--enable-bsf=aac_adtstoasc
--enable-pic
--extra-cflags=-fPIC -fvisibility=hidden
--disable-stripping
