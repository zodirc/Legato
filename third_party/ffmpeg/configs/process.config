# legato process: encoders, muxers, and libavfilter for legato-process / legato-mcp.
# GPL codecs (x264/x265) stay out unless a separate gpl config is requested.
--disable-gpl
--disable-nonfree
--disable-programs
--disable-doc
--disable-debug
--enable-static
--disable-shared
--enable-libdav1d
--enable-libvpx
--enable-libass
--extra-cflags=-fvisibility=hidden
--disable-stripping
